{
  "name": "joule",
  "private": true,
  "description": "Agent runtime that runs on a small model and escalates to a large one only when the evidence says the step needs it",
  "keywords": [
    "ai-agents",
    "llm",
    "slm",
    "small-language-models",
    "model-routing",
    "cascade",
    "escalation",
    "cost-optimization",
    "budget-enforcement",
    "typescript",
    "ollama",
    "openai",
    "anthropic",
    "openrouter"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint packages/",
    "clean": "pnpm -r clean",
    "dev": "pnpm -r --parallel dev",
    "lifecycle:collect": "tsx benchmarks/lifecycle/cli.ts collect",
    "lifecycle:analyze": "tsx benchmarks/lifecycle/cli.ts analyze"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  },
  "dependencies": {
    "playwright": "^1.58.2"
  }
}
